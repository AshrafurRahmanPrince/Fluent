<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme is applied to the Activity while Flutter initializes.
         It shows our green background instead of the default white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- NormalTheme is applied after Flutter renders its first frame.
         windowBackground is set to transparent so Flutter draws everything. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/fluento_bg</item>
    </style>
</resources>
